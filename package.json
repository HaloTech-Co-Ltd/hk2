{
  "name": "hk2",
  "version": "1.1.54",
  "description": "Knowledge-base-driven coding agent with per-project KB",
  "type": "module",
  "bin": {
    "hk2": "./bin/hk2"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.js'",
    "install:global": "npm link",
    "uninstall:global": "npm unlink -g hk2"
  },
  "dependencies": {
    "tree-sitter": "^0.21.1",
    "tree-sitter-bash": "^0.21.0",
    "tree-sitter-c": "^0.21.0",
    "tree-sitter-c-sharp": "^0.21.0",
    "tree-sitter-cpp": "^0.22.0",
    "tree-sitter-go": "^0.21.0",
    "tree-sitter-java": "^0.21.0",
    "tree-sitter-javascript": "^0.21.0",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-php": "^0.22.0",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-ruby": "^0.21.0",
    "tree-sitter-rust": "^0.21.0",
    "tree-sitter-scala": "^0.24.0",
    "tree-sitter-typescript": "^0.21.0"
  },
  "optionalDependencies": {
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1"
  },
  "allowScripts": {
    "tree-sitter@0.22.4": true,
    "tree-sitter-c@0.21.4": true,
    "tree-sitter-cpp@0.22.3": true,
    "tree-sitter-c-sharp@0.21.3": true,
    "tree-sitter-python@0.21.0": true,
    "tree-sitter-go@0.21.2": true,
    "tree-sitter-rust@0.21.0": true,
    "tree-sitter-java@0.21.0": true,
    "tree-sitter-javascript@0.21.4": true,
    "tree-sitter-typescript@0.21.2": true,
    "tree-sitter-ruby@0.21.0": true,
    "tree-sitter-php@0.22.8": true,
    "tree-sitter-bash@0.21.0": true,
    "tree-sitter-kotlin@0.3.8": true,
    "tree-sitter-scala@0.24.0": true
  }
}
